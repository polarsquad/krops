# Copy this file to `.env` and fill in the values. `.env` is gitignored and is
# loaded automatically by the lifecycle wrapper (scripts/toolbox-run.sh) and
# by the helper mise tasks (see mise.toml [settings] env_file = ".env").
#
#   cp .env.example .env

# ── GitOps source (GitHub-synced environments) ────────────────────────────────
# HTTPS URL of THIS repository. The aws and local-talos environments use it for
# Flux sync. Flux syncs the mgmt/ path from here.
GIT_REPO_URL="https://github.com/polarsquad/krops"

# ── GitHub PAT for Flux (GitHub-synced environments) ──────────────────────────
# Create a fine-grained token with read-only Contents access, or a classic token
# with the `repo` scope. The aws and local-talos environments use it for Flux to
# clone this repository; the Flux Operator chart is pulled anonymously.
GITHUB_TOKEN=""
# Basic-auth username paired with the token. Any non-empty value works for
# GitHub PATs; "git" is a safe default.
GITHUB_USER="git"

# ── SOPS age key (required) ───────────────────────────────────────────────────
# Path to the age PRIVATE key used by Flux to decrypt *.sops.yaml secrets.
# Generate one with the sops-keygen task in the toolbox (creates ./age.agekey,
# gitignored); see docs/secrets.md.
AGE_KEY_FILE="age.agekey"

# ── Container engine (optional) ───────────────────────────────────────────────
# bootstrap.sh auto-detects Docker or Podman (5.5+). Set this to force one:
# CONTAINER_ENGINE="podman"

# ── AWS credentials for CAPA (optional, for clusterawsadm) ────────────────────
# AWS credentials are NOT set here. They live SOPS-encrypted in Git at
# mgmt/capi-providers/capa-system/aws-credentials.sops.yaml and are
# decrypted in-cluster by Flux. To set/rotate them:
#
#   1. aws-bootstrap  (provisions IAM via CloudFormation)
#   2. aws-credentials (prints the base64 profile for the .sops.yaml)
#   3. sops-encrypt mgmt/aws/capi-providers/capa-system/aws-credentials.sops.yaml
#   All three are mise tasks run in the toolbox; see docs/aws.md and docs/secrets.md.
#
# AWS_REGION can be overridden here (default: eu-north-1):
# AWS_REGION="eu-west-1"

# ── Azure credentials (optional, azure environment) ───────────────────────────
# See docs/azure.md. AZURE_SUBSCRIPTION_ID is required for azure-bootstrap and
# the lifecycle wrapper; log in with `az login` first (the session persists in
# the host directory you mount to /root/.azure, set below).
# AZURE_SUBSCRIPTION_ID="<subscription-id>"
# Resource group / cluster location (default: swedencentral):
# AZURE_LOCATION="swedencentral"
# Host directory holding the `az login` session, mounted to /root/.azure; also
# required by the post-kind-create arc-federate task. See docs/azure.md.
# AZURE_CONFIG_DIR="/root/.azure"

# ── GCP project (optional, gcp environment) ───────────────────────────────────
# See docs/gcp.md. GCP_PROJECT is required for gcp-bootstrap and the lifecycle
# wrapper.
# GCP_PROJECT="<project-id>"
# GCP_REGION is forwarded into the toolbox container but nothing in this repo
# currently reads it; left here for parity with GCP_PROJECT until it's wired
# up or dropped.
# GCP_REGION="europe-north1"

# ── Not settable here (toolbox-computed) ──────────────────────────────────────
# ENGINE_SOCK, KUBECONFIG, and CLOUDSDK_CONFIG are always computed or
# hardcoded by scripts/toolbox-run.sh on every run; a value for any of them in
# this file is loaded into the shell but then unconditionally overwritten
# before the container starts, so it has no effect. See docs/operations.md
# ("Toolbox container").

# ── Other lifecycle knobs (optional) ──────────────────────────────────────────
# KROPS_PROFILE, REGISTRY_PORT, OCI_REPOSITORY/OCI_TAG, BOOTSTRAP_PIVOT,
# PIVOT_SKIP_DELETE, and the krops-bootstrap CLI's own knobs (MGMT_*,
# BOOTSTRAP_KUBECONTEXT, ...) are all operator-settable here; see the table in
# docs/bootstrap-cli.md ("Bootstrap and pivot controls") for defaults instead
# of duplicating it here.

# ── Notes ─────────────────────────────────────────────────────────────────────
# • NEVER commit .env, *.agekey, or any file containing real secrets
# • The .setup/ directory contains template keys from demos — remove before prod
# • If you see "SOPS decryption failed" in Flux, verify:
#     1. age.agekey public key matches the one in .sops.yaml
#     2. The sops-age secret exists in flux-system namespace
#     3. aws-credentials.sops.yaml is actually encrypted (not plaintext)
